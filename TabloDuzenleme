def Ogrenci_sil():

    while True:

        silinen_ogrenci = input(
            "Silinecek öğrencinin adı: "
        )

        if silinen_ogrenci in Ogrenciler:

            index = Ogrenciler.index(
                silinen_ogrenci
            )

            Ogrenciler.pop(index)
            genel_ortalama.pop(index)

            tablo_guncelle()

            print(
                f"{silinen_ogrenci} başarıyla silindi."
            )

            return

        else:
            print(
                "Öğrenci bulunamadı. Tekrar deneyiniz."
            )


def ad_degisim():

