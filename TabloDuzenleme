def not_degisim():

    while True:
        disim = input(
            "Değişim yapılacak öğrencinin adını giriniz: "
        )

        if disim not in Ogrenciler:
            print("İsim bulunamadı.")
            continue

        while True:
            try:
                dnot = int(input("Yeni notunu giriniz: "))

                if dnot < 0 or dnot > 100:
                    print("Geçerli bir not giriniz.")
                    continue

                index = Ogrenciler.index(disim)
                genel_ortalama[index] = dnot

                print("Not başarıyla değiştirildi.")
                return

            except ValueError:
                print("Gerçek bir not gir.")


def Ogrenci_sil():

    while True:
        silinen_ogrenci = input(
            "Silinecek öğrencinin adı: "
        )

        if silinen_ogrenci not in Ogrenciler:
            print("Öğrenci bulunamadı. Tekrar deneyiniz.")
            continue

        index = Ogrenciler.index(silinen_ogrenci)

        Ogrenciler.pop(index)
        genel_ortalama.pop(index)

        print("Öğrenci başarıyla silindi.")
        return


def ad_degisim():

    while True:
        ad = input(
            "Adı değiştirilecek öğrenci: "
        )

        if ad not in Ogrenciler:
            print("Listede bu isim yok.")
            continue

        yeni_isim = input("Yeni isim: ")

        index = Ogrenciler.index(ad)
        Ogrenciler[index] = yeni_isim

        print("İsim başarıyla değiştirildi.")
        return


def analiz():

    df = tabloyu_getir()

    if df.empty:
        print("\nHenüz öğrenci bulunmuyor.")
        return

    print("""
========================================
             TABLO ANALİZİ
========================================
""")

    toplam = len(df)
    sinif_ortalamasi = df["genel_ortalama"].mean()
    en_yuksek = df["genel_ortalama"].max()
    en_dusuk = df["genel_ortalama"].min()

    takdir = len(
        df[df["genel_ortalama"] >= 85]
    )

    basarisiz = len(
        df[df["genel_ortalama"] < 50]
    )

    print(f"Toplam Öğrenci       : {toplam}")
    print(f"Sınıf Ortalaması     : {sinif_ortalamasi:.2f}")
    print(f"En Yüksek Not        : {en_yuksek}")
    print(f"En Düşük Not         : {en_dusuk}")
    print(f"85+ Öğrenci          : {takdir}")
    print(f"50 Altı Öğrenci      : {basarisiz}")
