        ad = input(
            "Adı değiştirilecek öğrenci: "
        )

        if ad in Ogrenciler:

            print("İsim bulundu!")

            yeni_isim = input(
                "Yeni isim: "
            )

            index = Ogrenciler.index(ad)

            Ogrenciler[index] = yeni_isim

            tablo_guncelle()

            print(
                f"{ad} → {yeni_isim}"
            )

            return

        else:

            print(
                "Listede bu isim yok."
            )


def tabloyu_getir():

